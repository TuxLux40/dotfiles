# Keep secrets out of git

# Dotenv files (global)
.env
.env.local
.envrc
*.env
*.env.local
**/.env
**/.env.local
**/*.env

# But keep example templates tracked
!.env.example
!**/.env.example
!*.env.example

# atuin install receipt (regenerated by atuin's installer; runtime metadata, not config)
atuin/.config/atuin/atuin-receipt.json

# OpenRGB runtime output and the 0.9-era files it migrated on first 1.1 start
openrgb/.config/OpenRGB/logs/
openrgb/.config/OpenRGB/*.bak*
